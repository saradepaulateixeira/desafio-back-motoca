{
  "info": {
    "name": "Concessionaria API",
    "description": "API REST para gerenciamento de veículos e leads de concessionária",
    "schema": "https://schema.getpostman.com/json/ CollectionV2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@concessionaria.com\",\n  \"password\": \"password\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "path": ["api", "auth", "logout"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "path": ["api", "vehicles"]
            }
          },
          "response": []
        },
        {
          "name": "List Vehicles (Filter by Type)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?type=car",
              "path": ["api", "vehicles"],
              "query": [
                {
                  "key": "type",
                  "value": "car"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Vehicles (Filter by Max Price)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?max_price=80000",
              "path": ["api", "vehicles"],
              "query": [
                {
                  "key": "max_price",
                  "value": "80000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1",
              "path": ["api", "vehicles", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "path": ["api", "vehicles"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"car\",\n  \"model\": \"Civic\",\n  \"year\": 2024,\n  \"price\": 89900,\n  \"color\": \"Branco\",\n  \"mileage\": 0\n}"
            }
          },
          "response": []
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1",
              "path": ["api", "vehicles", "1"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2025,\n  \"price\": 95000\n}"
            }
          },
          "response": []
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1",
              "path": ["api", "vehicles", "1"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "response": []
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "path": ["api", "leads"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"phone\": \"(11) 99999-9999\",\n  \"vehicle_id\": 1,\n  \"message\": \"Tenho interesse\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/leads",
              "path": ["api", "leads"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "response": []
        },
        {
          "name": "Get Leads by Vehicle",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1/leads",
              "path": ["api", "vehicles", "1", "leads"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "path": ["api", "dashboard"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          },
          "response": []
        }
      ]
    }
  ]
}